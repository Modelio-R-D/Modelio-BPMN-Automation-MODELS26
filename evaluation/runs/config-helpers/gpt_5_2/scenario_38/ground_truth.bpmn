    <parallelGateway id="ParallelGateway_2">
      <incoming>SequenceFlow_22</incoming>
      <incoming>SequenceFlow_23</incoming>
      <outgoing>SequenceFlow_24</outgoing>
    </parallelGateway>
    <startEvent id="StartEvent_1" name="wish to build a house">
      <outgoing>SequenceFlow_1</outgoing>
    </startEvent>
    <endEvent id="EndEvent_1" name="finished house">
      <incoming>SequenceFlow_25</incoming>
    </endEvent>
    <intermediateCatchEvent id="IntermediateCatchEvent_1" name="draft received">
      <messageEventDefinition id="message_1"/>
      <incoming>SequenceFlow_2</incoming>
      <outgoing>SequenceFlow_4</outgoing>
    </intermediateCatchEvent>
    <intermediateCatchEvent id="IntermediateCatchEvent_2" name="Get order">
      <messageEventDefinition id="message_2"/>
      <incoming>SequenceFlow_17</incoming>
      <outgoing>SequenceFlow_22</outgoing>
    </intermediateCatchEvent>
    <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="UserTask_2"/>
    <sequenceFlow id="SequenceFlow_2" sourceRef="UserTask_1" targetRef="IntermediateCatchEvent_1"/>
