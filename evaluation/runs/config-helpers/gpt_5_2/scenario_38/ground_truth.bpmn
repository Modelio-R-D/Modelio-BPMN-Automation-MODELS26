<?xml version="1.0" ?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://www.omg.org/spec/BPMN/20100524/MODEL">
  <collaboration id="Collaboration_1">
    <participant id="Participant_1" name="Customer" processRef="Process_1"/>
    <participant id="Participant_2" name="Architect"/>
    <participant id="Participant_3" name="Online stores"/>
    <messageFlow id="MessageFlow_1" sourceRef="UserTask_1" targetRef="Participant_2"/>
