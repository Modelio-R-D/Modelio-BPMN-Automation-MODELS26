    <messageFlow id="MessageFlow_3" sourceRef="Participant_3" targetRef="IntermediateCatchEvent_2"/>
    <messageFlow id="MessageFlow_4" sourceRef="UserTask_5" targetRef="Participant_3"/>
  </collaboration>
  <process id="Process_1">
    <laneSet id="LaneSet_1">
      <lane id="Lane_1">
        <flowNodeRef>UserTask_1</flowNodeRef>
        <flowNodeRef>UserTask_2</flowNodeRef>
        <flowNodeRef>StartEvent_1</flowNodeRef>
        <flowNodeRef>UserTask_3</flowNodeRef>
        <flowNodeRef>UserTask_4</flowNodeRef>
        <flowNodeRef>IntermediateCatchEvent_1</flowNodeRef>
        <flowNodeRef>UserTask_5</flowNodeRef>
        <flowNodeRef>ExclusiveGateway_1</flowNodeRef>
        <flowNodeRef>ExclusiveGateway_2</flowNodeRef>
        <flowNodeRef>ServiceTask_1</flowNodeRef>
        <flowNodeRef>ExclusiveGateway_3</flowNodeRef>
        <flowNodeRef>ExclusiveGateway_4</flowNodeRef>
        <flowNodeRef>ServiceTask_2</flowNodeRef>
        <flowNodeRef>ServiceTask_3</flowNodeRef>
        <flowNodeRef>ParallelGateway_1</flowNodeRef>
        <flowNodeRef>ExclusiveGateway_5</flowNodeRef>
        <flowNodeRef>ManualTask_1</flowNodeRef>
        <flowNodeRef>IntermediateCatchEvent_2</flowNodeRef>
        <flowNodeRef>ParallelGateway_2</flowNodeRef>
        <flowNodeRef>ManualTask_2</flowNodeRef>
        <flowNodeRef>EndEvent_1</flowNodeRef>
        <flowNodeRef>ExclusiveGateway_6</flowNodeRef>
        <flowNodeRef>ManualTask_3</flowNodeRef>
      </lane>
    </laneSet>
    <userTask id="UserTask_1" name="Send requirements">
      <incoming>SequenceFlow_6</incoming>
      <outgoing>SequenceFlow_2</outgoing>
    </userTask>
    <userTask id="UserTask_2" name="Collect requirements">
      <incoming>SequenceFlow_1</incoming>
      <outgoing>SequenceFlow_7</outgoing>
    </userTask>
    <userTask id="UserTask_3" name="Refine requirements">
      <incoming>SequenceFlow_10</incoming>
      <outgoing>SequenceFlow_5</outgoing>
    </userTask>
    <userTask id="UserTask_4" name="Create order list">
      <incoming>SequenceFlow_13</incoming>
      <outgoing>SequenceFlow_3</outgoing>
    </userTask>
    <userTask id="UserTask_5" name="Place order">
      <incoming>SequenceFlow_3</incoming>
      <outgoing>SequenceFlow_14</outgoing>
    </userTask>
    <serviceTask id="ServiceTask_1" name="Report for builing permit">
      <incoming>SequenceFlow_8</incoming>
      <outgoing>SequenceFlow_11</outgoing>
    </serviceTask>
    <serviceTask id="ServiceTask_2" name="Calculate effort">
      <incoming>SequenceFlow_14</incoming>
      <outgoing>SequenceFlow_15</outgoing>
