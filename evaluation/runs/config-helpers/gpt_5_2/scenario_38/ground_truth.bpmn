    <sequenceFlow id="SequenceFlow_16" sourceRef="ServiceTask_3" targetRef="ExclusiveGateway_1"/>
    <sequenceFlow id="SequenceFlow_17" sourceRef="ParallelGateway_1" targetRef="IntermediateCatchEvent_2"/>
    <sequenceFlow id="SequenceFlow_18" sourceRef="ParallelGateway_1" targetRef="ExclusiveGateway_5"/>
    <sequenceFlow id="SequenceFlow_19" name="No" sourceRef="ExclusiveGateway_5" targetRef="ManualTask_1"/>
    <sequenceFlow id="SequenceFlow_20" name="Yes" sourceRef="ExclusiveGateway_5" targetRef="ManualTask_3"/>
    <sequenceFlow id="SequenceFlow_21" sourceRef="ManualTask_1" targetRef="ExclusiveGateway_6"/>
    <sequenceFlow id="SequenceFlow_22" sourceRef="IntermediateCatchEvent_2" targetRef="ParallelGateway_2"/>
    <sequenceFlow id="SequenceFlow_23" sourceRef="ExclusiveGateway_6" targetRef="ParallelGateway_2"/>
