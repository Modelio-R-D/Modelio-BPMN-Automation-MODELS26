<?xml version="1.0" ?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://www.omg.org/spec/BPMN/20100524/MODEL">
  <process id="Process_1">
    <task id="Task_1" name="Record order in system">
      <incoming>SequenceFlow_13</incoming>
      <outgoing>SequenceFlow_4</outgoing>
    </task>
    <task id="Task_2" name="Collect customer information">
      <incoming>SequenceFlow_10</incoming>
      <outgoing>SequenceFlow_8</outgoing>
    </task>
    <task id="Task_3" name="Guide customer in selecting product/service">
      <incoming>SequenceFlow_14</incoming>
      <outgoing>SequenceFlow_18</outgoing>
    </task>
    <task id="Task_4" name="Provide quote">
      <incoming>SequenceFlow_18</incoming>
      <outgoing>SequenceFlow_15</outgoing>
    </task>
    <task id="Task_5" name="Receive customer inquiry">
      <incoming>SequenceFlow_9</incoming>
      <outgoing>SequenceFlow_17</outgoing>
    </task>
    <task id="Task_6" name="Place order">
      <incoming>SequenceFlow_16</incoming>
      <outgoing>SequenceFlow_13</outgoing>
    </task>
    <task id="Task_7" name="Address customer concerns or questions">
      <incoming>SequenceFlow_3</incoming>
      <outgoing>SequenceFlow_5</outgoing>
    </task>
    <task id="Task_8" name="Send order confirmation to customer">
      <incoming>SequenceFlow_4</incoming>
      <outgoing>SequenceFlow_1</outgoing>
    </task>
    <exclusiveGateway id="ExclusiveGateway_1">
      <incoming>SequenceFlow_1</incoming>
      <incoming>SequenceFlow_12</incoming>
      <outgoing>SequenceFlow_7</outgoing>
    </exclusiveGateway>
    <exclusiveGateway id="ExclusiveGateway_2">
      <incoming>SequenceFlow_15</incoming>
      <outgoing>SequenceFlow_12</outgoing>
      <outgoing>SequenceFlow_16</outgoing>
    </exclusiveGateway>
    <exclusiveGateway id="ExclusiveGateway_3">
      <incoming>SequenceFlow_7</incoming>
      <incoming>SequenceFlow_11</incoming>
      <outgoing>SequenceFlow_2</outgoing>
    </exclusiveGateway>
    <exclusiveGateway id="ExclusiveGateway_4">
      <incoming>SequenceFlow_6</incoming>
      <outgoing>SequenceFlow_11</outgoing>
      <outgoing>SequenceFlow_14</outgoing>
    </exclusiveGateway>
    <parallelGateway id="ParallelGateway_1">
      <incoming>SequenceFlow_5</incoming>
      <incoming>SequenceFlow_8</incoming>
      <outgoing>SequenceFlow_6</outgoing>
    </parallelGateway>
    <parallelGateway id="ParallelGateway_2">
      <incoming>SequenceFlow_17</incoming>
      <outgoing>SequenceFlow_3</outgoing>
      <outgoing>SequenceFlow_10</outgoing>
    </parallelGateway>
    <startEvent id="StartEvent_1" name="start">
      <outgoing>SequenceFlow_9</outgoing>
    </startEvent>
    <endEvent id="EndEvent_1" name="end">
      <incoming>SequenceFlow_2</incoming>
    </endEvent>
    <sequenceFlow id="SequenceFlow_1" sourceRef="Task_8" targetRef="ExclusiveGateway_1"/>
    <sequenceFlow id="SequenceFlow_2" sourceRef="ExclusiveGateway_3" targetRef="EndEvent_1"/>
    <sequenceFlow id="SequenceFlow_3" sourceRef="ParallelGateway_2" targetRef="Task_7"/>
    <sequenceFlow id="SequenceFlow_4" sourceRef="Task_1" targetRef="Task_8"/>
    <sequenceFlow id="SequenceFlow_5" sourceRef="Task_7" targetRef="ParallelGateway_1"/>
    <sequenceFlow id="SequenceFlow_6" sourceRef="ParallelGateway_1" targetRef="ExclusiveGateway_4"/>
    <sequenceFlow id="SequenceFlow_7" sourceRef="ExclusiveGateway_1" targetRef="ExclusiveGateway_3"/>
    <sequenceFlow id="SequenceFlow_8" sourceRef="Task_2" targetRef="ParallelGateway_1"/>
    <sequenceFlow id="SequenceFlow_9" sourceRef="StartEvent_1" targetRef="Task_5"/>
    <sequenceFlow id="SequenceFlow_10" sourceRef="ParallelGateway_2" targetRef="Task_2"/>
    <sequenceFlow id="SequenceFlow_11" sourceRef="ExclusiveGateway_4" targetRef="ExclusiveGateway_3"/>
    <sequenceFlow id="SequenceFlow_12" sourceRef="ExclusiveGateway_2" targetRef="ExclusiveGateway_1"/>
    <sequenceFlow id="SequenceFlow_13" sourceRef="Task_6" targetRef="Task_1"/>
    <sequenceFlow id="SequenceFlow_14" sourceRef="ExclusiveGateway_4" targetRef="Task_3"/>
    <sequenceFlow id="SequenceFlow_15" sourceRef="Task_4" targetRef="ExclusiveGateway_2"/>
    <sequenceFlow id="SequenceFlow_16" sourceRef="ExclusiveGateway_2" targetRef="Task_6"/>
    <sequenceFlow id="SequenceFlow_17" sourceRef="Task_5" targetRef="ParallelGateway_2"/>
    <sequenceFlow id="SequenceFlow_18" sourceRef="Task_3" targetRef="Task_4"/>
  </process>
</definitions>