<?xml version="1.0" ?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://www.omg.org/spec/BPMN/20100524/MODEL">
  <collaboration id="Collaboration_1">
    <participant id="Participant_1" name="Dispatch of goods Computer Hardware Shop" processRef="Process_1"/>
  </collaboration>
  <process id="Process_1">
    <laneSet id="LaneSet_1">
      <lane id="Lane_1" name="Logistics">
        <flowNodeRef>Task_1</flowNodeRef>
      </lane>
      <lane id="Lane_2" name="Secretary">
        <flowNodeRef>Task_2</flowNodeRef>
        <flowNodeRef>Task_3</flowNodeRef>
        <flowNodeRef>Task_4</flowNodeRef>
        <flowNodeRef>Task_5</flowNodeRef>
        <flowNodeRef>InclusiveGateway_1</flowNodeRef>
        <flowNodeRef>InclusiveGateway_2</flowNodeRef>
        <flowNodeRef>StartEvent_1</flowNodeRef>
        <flowNodeRef>ParallelGateway_1</flowNodeRef>
        <flowNodeRef>ExclusiveGateway_1</flowNodeRef>
        <flowNodeRef>ExclusiveGateway_2</flowNodeRef>
      </lane>
      <lane id="Lane_3" name="Warehouse">
        <flowNodeRef>Task_6</flowNodeRef>
        <flowNodeRef>Task_7</flowNodeRef>
        <flowNodeRef>ExclusiveGateway_3</flowNodeRef>
        <flowNodeRef>EndEvent_1</flowNodeRef>
      </lane>
    </laneSet>
    <task id="Task_1" name="Insure parcel">
      <incoming>SequenceFlow_2</incoming>
      <outgoing>SequenceFlow_5</outgoing>
    </task>
    <task id="Task_2" name="Write package label">
      <incoming>SequenceFlow_3</incoming>
      <outgoing>SequenceFlow_4</outgoing>
    </task>
    <task id="Task_3" name="Clarify shipment method">
      <incoming>SequenceFlow_7</incoming>
      <outgoing>SequenceFlow_8</outgoing>
    </task>
    <task id="Task_4" name="Get 3 offers from logistic companies">
      <incoming>SequenceFlow_9</incoming>
      <outgoing>SequenceFlow_10</outgoing>
    </task>
    <task id="Task_5" name="Select logistic company and place order">
      <incoming>SequenceFlow_10</incoming>
      <outgoing>SequenceFlow_11</outgoing>
    </task>
    <task id="Task_6" name="Package goods">
      <incoming>SequenceFlow_17</incoming>
      <outgoing>SequenceFlow_14</outgoing>
    </task>
    <task id="Task_7" name="Prepare for picking up goods">
      <incoming>SequenceFlow_15</incoming>
      <outgoing>SequenceFlow_16</outgoing>
    </task>
    <exclusiveGateway id="ExclusiveGateway_1" name="Special sandling?">
      <incoming>SequenceFlow_8</incoming>
      <outgoing>SequenceFlow_1</outgoing>
      <outgoing>SequenceFlow_9</outgoing>
    </exclusiveGateway>
    <exclusiveGateway id="ExclusiveGateway_2">
      <incoming>SequenceFlow_11</incoming>
      <incoming>SequenceFlow_12</incoming>
      <outgoing>SequenceFlow_13</outgoing>
    </exclusiveGateway>
    <exclusiveGateway id="ExclusiveGateway_3">
      <incoming>SequenceFlow_13</incoming>
      <incoming>SequenceFlow_14</incoming>
      <outgoing>SequenceFlow_15</outgoing>
    </exclusiveGateway>
    <parallelGateway id="ParallelGateway_1">
      <incoming>SequenceFlow_6</incoming>
      <outgoing>SequenceFlow_7</outgoing>
      <outgoing>SequenceFlow_17</outgoing>
    </parallelGateway>
    <inclusiveGateway id="InclusiveGateway_1">
      <incoming>SequenceFlow_1</incoming>
      <outgoing>SequenceFlow_2</outgoing>
      <outgoing>SequenceFlow_3</outgoing>
    </inclusiveGateway>
    <inclusiveGateway id="InclusiveGateway_2">
      <incoming>SequenceFlow_4</incoming>
      <incoming>SequenceFlow_5</incoming>
      <outgoing>SequenceFlow_12</outgoing>
    </inclusiveGateway>
    <startEvent id="StartEvent_1" name="Ship goods">
      <outgoing>SequenceFlow_6</outgoing>
    </startEvent>
    <endEvent id="EndEvent_1" name="Shipment prepared">
      <incoming>SequenceFlow_16</incoming>
    </endEvent>
    <sequenceFlow id="SequenceFlow_1" name="no" sourceRef="ExclusiveGateway_1" targetRef="InclusiveGateway_1"/>
    <sequenceFlow id="SequenceFlow_2" name="If insurance necessary" sourceRef="InclusiveGateway_1" targetRef="Task_1"/>
    <sequenceFlow id="SequenceFlow_3" name="always" sourceRef="InclusiveGateway_1" targetRef="Task_2"/>
    <sequenceFlow id="SequenceFlow_4" sourceRef="Task_2" targetRef="InclusiveGateway_2"/>
    <sequenceFlow id="SequenceFlow_5" sourceRef="Task_1" targetRef="InclusiveGateway_2"/>
    <sequenceFlow id="SequenceFlow_6" sourceRef="StartEvent_1" targetRef="ParallelGateway_1"/>
    <sequenceFlow id="SequenceFlow_7" sourceRef="ParallelGateway_1" targetRef="Task_3"/>
    <sequenceFlow id="SequenceFlow_8" sourceRef="Task_3" targetRef="ExclusiveGateway_1"/>
    <sequenceFlow id="SequenceFlow_9" name="yes" sourceRef="ExclusiveGateway_1" targetRef="Task_4"/>
    <sequenceFlow id="SequenceFlow_10" sourceRef="Task_4" targetRef="Task_5"/>
    <sequenceFlow id="SequenceFlow_11" sourceRef="Task_5" targetRef="ExclusiveGateway_2"/>
    <sequenceFlow id="SequenceFlow_12" sourceRef="InclusiveGateway_2" targetRef="ExclusiveGateway_2"/>
    <sequenceFlow id="SequenceFlow_13" sourceRef="ExclusiveGateway_2" targetRef="ExclusiveGateway_3"/>
    <sequenceFlow id="SequenceFlow_14" sourceRef="Task_6" targetRef="ExclusiveGateway_3"/>
    <sequenceFlow id="SequenceFlow_15" sourceRef="ExclusiveGateway_3" targetRef="Task_7"/>
    <sequenceFlow id="SequenceFlow_16" sourceRef="Task_7" targetRef="EndEvent_1"/>
    <sequenceFlow id="SequenceFlow_17" sourceRef="ParallelGateway_1" targetRef="Task_6"/>
  </process>
</definitions>