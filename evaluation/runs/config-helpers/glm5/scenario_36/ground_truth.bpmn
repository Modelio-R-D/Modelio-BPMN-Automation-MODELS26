    <sequenceFlow id="SequenceFlow_16" sourceRef="ManualTask_1" targetRef="ParallelGateway_2"/>
    <sequenceFlow id="SequenceFlow_17" sourceRef="ParallelGateway_2" targetRef="ManualTask_2"/>
    <sequenceFlow id="SequenceFlow_18" sourceRef="ManualTask_4" targetRef="ReceiveTask_2"/>
    <sequenceFlow id="SequenceFlow_19" sourceRef="ReceiveTask_2" targetRef="EndEvent_1"/>
    <sequenceFlow id="SequenceFlow_20" name="No" sourceRef="ExclusiveGateway_4" targetRef="ManualTask_5"/>
    <sequenceFlow id="SequenceFlow_21" sourceRef="ParallelGateway_3" targetRef="ManualTask_3"/>
    <sequenceFlow id="SequenceFlow_22" sourceRef="ManualTask_3" targetRef="ExclusiveGateway_4"/>
    <sequenceFlow id="SequenceFlow_23" sourceRef="ParallelGateway_3" targetRef="UserTask_5"/>
    <sequenceFlow id="SequenceFlow_24" sourceRef="UserTask_5" targetRef="SendTask_7"/>
    <sequenceFlow id="SequenceFlow_25" sourceRef="SendTask_7" targetRef="ParallelGateway_4"/>
    <sequenceFlow id="SequenceFlow_26" name="Yes" sourceRef="ExclusiveGateway_4" targetRef="ParallelGateway_4"/>
    <sequenceFlow id="SequenceFlow_27" sourceRef="ParallelGateway_4" targetRef="ManualTask_4"/>
    <sequenceFlow id="SequenceFlow_28" sourceRef="SendTask_4" targetRef="ExclusiveGateway_3"/>
    <sequenceFlow id="SequenceFlow_29" sourceRef="SendTask_5" targetRef="ExclusiveGateway_3"/>
    <sequenceFlow id="SequenceFlow_30" sourceRef="SendTask_6" targetRef="ExclusiveGateway_3"/>
    <sequenceFlow id="SequenceFlow_31" sourceRef="ManualTask_2" targetRef="ParallelGateway_3"/>
    <sequenceFlow id="SequenceFlow_32" sourceRef="ManualTask_5" targetRef="ManualTask_3"/>
    <sequenceFlow id="SequenceFlow_33" name="Yes" sourceRef="ExclusiveGateway_1" targetRef="SendTask_1"/>
    <sequenceFlow id="SequenceFlow_34" name="No" sourceRef="ExclusiveGateway_1" targetRef="ManualTask_2"/>
    <sequenceFlow id="SequenceFlow_35" name="Vodka bar" sourceRef="ExclusiveGateway_2" targetRef="SendTask_2"/>
    <sequenceFlow id="SequenceFlow_36" name="Whiskey bar" sourceRef="ExclusiveGateway_2" targetRef="SendTask_3"/>
    <sequenceFlow id="SequenceFlow_37" name="Wine bar" sourceRef="ExclusiveGateway_2" targetRef="SendTask_4"/>
    <sequenceFlow id="SequenceFlow_38" name="Cocktail bar" sourceRef="ExclusiveGateway_2" targetRef="SendTask_5"/>
    <sequenceFlow id="SequenceFlow_39" name="Aperol bar" sourceRef="ExclusiveGateway_2" targetRef="SendTask_6"/>
  </process>
