<?xml version="1.0" ?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://www.omg.org/spec/BPMN/20100524/MODEL">
  <process id="Process_1">
    <userTask id="UserTask_1" name="Select type of order">
      <incoming>SequenceFlow_1</incoming>
      <outgoing>SequenceFlow_2</outgoing>
    </userTask>
    <userTask id="UserTask_2" name="Select burger">
      <incoming>SequenceFlow_26</incoming>
      <outgoing>SequenceFlow_14</outgoing>
    </userTask>
    <userTask id="UserTask_3" name="Select type of beverage">
      <incoming>SequenceFlow_13</incoming>
      <outgoing>SequenceFlow_3</outgoing>
    </userTask>
    <userTask id="UserTask_4" name="Select side">
      <incoming>SequenceFlow_5</incoming>
      <outgoing>SequenceFlow_7</outgoing>
    </userTask>
    <userTask id="UserTask_5" name="Select menu">
      <incoming>SequenceFlow_15</incoming>
      <outgoing>SequenceFlow_13</outgoing>
    </userTask>
    <userTask id="UserTask_6" name="Make payment">
      <incoming>SequenceFlow_32</incoming>
      <outgoing>SequenceFlow_30</outgoing>
    </userTask>
    <userTask id="UserTask_7" name="Enter customer's name">
      <incoming>SequenceFlow_30</incoming>
      <outgoing>SequenceFlow_31</outgoing>
    </userTask>
    <serviceTask id="ServiceTask_1" name="Prepare beverage">
      <incoming>SequenceFlow_4</incoming>
      <outgoing>SequenceFlow_6</outgoing>
    </serviceTask>
    <serviceTask id="ServiceTask_2" name="Prepare potato wedges">
      <incoming>SequenceFlow_10</incoming>
      <outgoing>SequenceFlow_8</outgoing>
    </serviceTask>
    <serviceTask id="ServiceTask_3" name="Prepare French fries">
      <incoming>SequenceFlow_11</incoming>
      <outgoing>SequenceFlow_9</outgoing>
    </serviceTask>
    <serviceTask id="ServiceTask_4" name="Prepare burger">
      <incoming>SequenceFlow_29</incoming>
      <outgoing>SequenceFlow_20</outgoing>
    </serviceTask>
    <serviceTask id="ServiceTask_5" name="Check status">
      <incoming>SequenceFlow_18</incoming>
      <outgoing>SequenceFlow_19</outgoing>
    </serviceTask>
    <serviceTask id="ServiceTask_6" name="Update status">
      <incoming>SequenceFlow_22</incoming>
      <outgoing>SequenceFlow_23</outgoing>
    </serviceTask>
    <serviceTask id="ServiceTask_7" name="Deliver via conveyor belt">
      <incoming>SequenceFlow_25</incoming>
      <outgoing>SequenceFlow_21</outgoing>
    </serviceTask>
    <serviceTask id="ServiceTask_8" name="Notify customer">
      <incoming>SequenceFlow_24</incoming>
      <outgoing>SequenceFlow_25</outgoing>
    </serviceTask>
    <exclusiveGateway id="ExclusiveGateway_1" name="Menu or just the burger ?">
      <incoming>SequenceFlow_2</incoming>
      <outgoing>SequenceFlow_15</outgoing>
      <outgoing>SequenceFlow_26</outgoing>
    </exclusiveGateway>
    <exclusiveGateway id="ExclusiveGateway_2" name="Fries or wedges ?">
      <incoming>SequenceFlow_12</incoming>
      <outgoing>SequenceFlow_10</outgoing>
      <outgoing>SequenceFlow_11</outgoing>
    </exclusiveGateway>
    <exclusiveGateway id="ExclusiveGateway_3">
      <incoming>SequenceFlow_8</incoming>
      <incoming>SequenceFlow_9</incoming>
      <outgoing>SequenceFlow_16</outgoing>
    </exclusiveGateway>
    <exclusiveGateway id="ExclusiveGateway_4">
      <incoming>SequenceFlow_14</incoming>
      <incoming>SequenceFlow_16</incoming>
      <outgoing>SequenceFlow_32</outgoing>
    </exclusiveGateway>
    <exclusiveGateway id="ExclusiveGateway_5">
      <incoming>SequenceFlow_17</incoming>
      <incoming>SequenceFlow_27</incoming>
      <outgoing>SequenceFlow_22</outgoing>
    </exclusiveGateway>
    <exclusiveGateway id="ExclusiveGateway_6" name="Is burger ready ?">
      <incoming>SequenceFlow_19</incoming>
      <outgoing>SequenceFlow_27</outgoing>
      <outgoing>SequenceFlow_28</outgoing>
    </exclusiveGateway>
    <parallelGateway id="ParallelGateway_1">
      <incoming>SequenceFlow_3</incoming>
      <outgoing>SequenceFlow_4</outgoing>
      <outgoing>SequenceFlow_5</outgoing>
    </parallelGateway>
    <parallelGateway id="ParallelGateway_2">
      <incoming>SequenceFlow_6</incoming>
      <incoming>SequenceFlow_7</incoming>
      <outgoing>SequenceFlow_12</outgoing>
    </parallelGateway>
    <parallelGateway id="ParallelGateway_3">
      <incoming>SequenceFlow_31</incoming>
      <outgoing>SequenceFlow_17</outgoing>
      <outgoing>SequenceFlow_29</outgoing>
    </parallelGateway>
    <parallelGateway id="ParallelGateway_4">
      <incoming>SequenceFlow_20</incoming>
      <incoming>SequenceFlow_28</incoming>
      <outgoing>SequenceFlow_24</outgoing>
    </parallelGateway>
    <startEvent id="StartEvent_1" name="Food order decided">
      <outgoing>SequenceFlow_1</outgoing>
    </startEvent>
    <endEvent id="EndEvent_1" name="Food delivered">
      <incoming>SequenceFlow_21</incoming>
    </endEvent>
    <intermediateCatchEvent id="IntermediateCatchEvent_1" name="30 seconds">
      <timerEventDefinition id="timer_1"/>
      <incoming>SequenceFlow_23</incoming>
      <outgoing>SequenceFlow_18</outgoing>
    </intermediateCatchEvent>
    <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="UserTask_1"/>
    <sequenceFlow id="SequenceFlow_2" sourceRef="UserTask_1" targetRef="ExclusiveGateway_1"/>
    <sequenceFlow id="SequenceFlow_3" sourceRef="UserTask_3" targetRef="ParallelGateway_1"/>
    <sequenceFlow id="SequenceFlow_4" sourceRef="ParallelGateway_1" targetRef="ServiceTask_1"/>
    <sequenceFlow id="SequenceFlow_5" sourceRef="ParallelGateway_1" targetRef="UserTask_4"/>
    <sequenceFlow id="SequenceFlow_6" sourceRef="ServiceTask_1" targetRef="ParallelGateway_2"/>
    <sequenceFlow id="SequenceFlow_7" sourceRef="UserTask_4" targetRef="ParallelGateway_2"/>
    <sequenceFlow id="SequenceFlow_8" sourceRef="ServiceTask_2" targetRef="ExclusiveGateway_3"/>
    <sequenceFlow id="SequenceFlow_9" sourceRef="ServiceTask_3" targetRef="ExclusiveGateway_3"/>
    <sequenceFlow id="SequenceFlow_10" name="Potato wedges" sourceRef="ExclusiveGateway_2" targetRef="ServiceTask_2"/>
    <sequenceFlow id="SequenceFlow_11" name="French fries" sourceRef="ExclusiveGateway_2" targetRef="ServiceTask_3"/>
    <sequenceFlow id="SequenceFlow_12" sourceRef="ParallelGateway_2" targetRef="ExclusiveGateway_2"/>
    <sequenceFlow id="SequenceFlow_13" sourceRef="UserTask_5" targetRef="UserTask_3"/>
    <sequenceFlow id="SequenceFlow_14" sourceRef="UserTask_2" targetRef="ExclusiveGateway_4"/>
    <sequenceFlow id="SequenceFlow_15" name="With menu" sourceRef="ExclusiveGateway_1" targetRef="UserTask_5"/>
    <sequenceFlow id="SequenceFlow_16" sourceRef="ExclusiveGateway_3" targetRef="ExclusiveGateway_4"/>
    <sequenceFlow id="SequenceFlow_17" sourceRef="ParallelGateway_3" targetRef="ExclusiveGateway_5"/>
    <sequenceFlow id="SequenceFlow_18" sourceRef="IntermediateCatchEvent_1" targetRef="ServiceTask_5"/>
    <sequenceFlow id="SequenceFlow_19" sourceRef="ServiceTask_5" targetRef="ExclusiveGateway_6"/>
    <sequenceFlow id="SequenceFlow_20" sourceRef="ServiceTask_4" targetRef="ParallelGateway_4"/>
    <sequenceFlow id="SequenceFlow_21" sourceRef="ServiceTask_7" targetRef="EndEvent_1"/>
    <sequenceFlow id="SequenceFlow_22" sourceRef="ExclusiveGateway_5" targetRef="ServiceTask_6"/>
    <sequenceFlow id="SequenceFlow_23" sourceRef="ServiceTask_6" targetRef="IntermediateCatchEvent_1"/>
    <sequenceFlow id="SequenceFlow_24" sourceRef="ParallelGateway_4" targetRef="ServiceTask_8"/>
    <sequenceFlow id="SequenceFlow_25" sourceRef="ServiceTask_8" targetRef="ServiceTask_7"/>
    <sequenceFlow id="SequenceFlow_26" name="Burger only" sourceRef="ExclusiveGateway_1" targetRef="UserTask_2"/>
    <sequenceFlow id="SequenceFlow_27" name="No" sourceRef="ExclusiveGateway_6" targetRef="ExclusiveGateway_5"/>
    <sequenceFlow id="SequenceFlow_28" name="Yes" sourceRef="ExclusiveGateway_6" targetRef="ParallelGateway_4"/>
    <sequenceFlow id="SequenceFlow_29" sourceRef="ParallelGateway_3" targetRef="ServiceTask_4"/>
    <sequenceFlow id="SequenceFlow_30" sourceRef="UserTask_6" targetRef="UserTask_7"/>
    <sequenceFlow id="SequenceFlow_31" sourceRef="UserTask_7" targetRef="ParallelGateway_3"/>
    <sequenceFlow id="SequenceFlow_32" sourceRef="ExclusiveGateway_4" targetRef="UserTask_6"/>
  </process>
</definitions>