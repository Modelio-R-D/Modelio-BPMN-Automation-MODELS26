<?xml version="1.0" ?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://www.omg.org/spec/BPMN/20100524/MODEL">
  <process id="Process_1">
    <task id="Task_1" name="customer waits until bank confirms payment">
      <incoming>SequenceFlow_26</incoming>
      <outgoing>SequenceFlow_27</outgoing>
    </task>
    <serviceTask id="ServiceTask_1" name="customer credentials being checked by system">
      <incoming>SequenceFlow_2</incoming>
      <outgoing>SequenceFlow_3</outgoing>
    </serviceTask>
    <serviceTask id="ServiceTask_2" name="Payment is prepared by system">
      <incoming>SequenceFlow_8</incoming>
      <outgoing>SequenceFlow_12</outgoing>
    </serviceTask>
    <serviceTask id="ServiceTask_3" name="Shipment is prepared by system">
      <incoming>SequenceFlow_9</incoming>
      <outgoing>SequenceFlow_13</outgoing>
    </serviceTask>
    <serviceTask id="ServiceTask_4" name="order is being finished by system">
      <incoming>SequenceFlow_10</incoming>
      <outgoing>SequenceFlow_22</outgoing>
    </serviceTask>
    <manualTask id="ManualTask_1" name="customer logs into E-Shop">
      <incoming>SequenceFlow_1</incoming>
      <outgoing>SequenceFlow_2</outgoing>
    </manualTask>
    <manualTask id="ManualTask_2" name="customer selects a product">
      <incoming>SequenceFlow_24</incoming>
      <outgoing>SequenceFlow_4</outgoing>
    </manualTask>
    <manualTask id="ManualTask_3" name="customer adds product to shopping cart">
      <incoming>SequenceFlow_4</incoming>
      <outgoing>SequenceFlow_5</outgoing>
    </manualTask>
    <manualTask id="ManualTask_4" name="customer saves product">
      <incoming>SequenceFlow_5</incoming>
      <outgoing>SequenceFlow_6</outgoing>
    </manualTask>
    <manualTask id="ManualTask_5" name="customer checks if product was already selected">
      <incoming>SequenceFlow_6</incoming>
      <outgoing>SequenceFlow_7</outgoing>
    </manualTask>
    <manualTask id="ManualTask_6" name="customer enters payment data">
      <incoming>SequenceFlow_14</incoming>
      <outgoing>SequenceFlow_11</outgoing>
    </manualTask>
    <manualTask id="ManualTask_7" name="customer enters shipping address">
      <incoming>SequenceFlow_15</incoming>
      <outgoing>SequenceFlow_16</outgoing>
    </manualTask>
    <manualTask id="ManualTask_8" name="customer enters an independent billing adress">
      <incoming>SequenceFlow_20</incoming>
      <outgoing>SequenceFlow_17</outgoing>
    </manualTask>
    <exclusiveGateway id="ExclusiveGateway_1" name="succesful login?">
      <incoming>SequenceFlow_3</incoming>
      <outgoing>SequenceFlow_25</outgoing>
      <outgoing>SequenceFlow_29</outgoing>
    </exclusiveGateway>
    <exclusiveGateway id="ExclusiveGateway_2" name="has customer selected all desired products?">
      <incoming>SequenceFlow_7</incoming>
      <outgoing>SequenceFlow_21</outgoing>
      <outgoing>SequenceFlow_28</outgoing>
    </exclusiveGateway>
    <exclusiveGateway id="ExclusiveGateway_3" name="if shipping adress == billing adress?">
      <incoming>SequenceFlow_16</incoming>
      <outgoing>SequenceFlow_19</outgoing>
      <outgoing>SequenceFlow_20</outgoing>
    </exclusiveGateway>
    <exclusiveGateway id="ExclusiveGateway_4">
      <incoming>SequenceFlow_17</incoming>
      <incoming>SequenceFlow_19</incoming>
      <outgoing>SequenceFlow_18</outgoing>
    </exclusiveGateway>
    <exclusiveGateway id="ExclusiveGateway_5">
      <incoming>SequenceFlow_22</incoming>
      <incoming>SequenceFlow_29</incoming>
      <outgoing>SequenceFlow_23</outgoing>
    </exclusiveGateway>
    <exclusiveGateway id="ExclusiveGateway_6">
      <incoming>SequenceFlow_25</incoming>
      <incoming>SequenceFlow_28</incoming>
      <outgoing>SequenceFlow_24</outgoing>
    </exclusiveGateway>
    <parallelGateway id="ParallelGateway_1">
      <incoming>SequenceFlow_21</incoming>
      <outgoing>SequenceFlow_8</outgoing>
      <outgoing>SequenceFlow_9</outgoing>
    </parallelGateway>
    <parallelGateway id="ParallelGateway_2">
      <incoming>SequenceFlow_18</incoming>
      <incoming>SequenceFlow_27</incoming>
      <outgoing>SequenceFlow_10</outgoing>
    </parallelGateway>
    <parallelGateway id="ParallelGateway_3">
      <incoming>SequenceFlow_11</incoming>
      <outgoing>SequenceFlow_15</outgoing>
      <outgoing>SequenceFlow_26</outgoing>
    </parallelGateway>
    <parallelGateway id="ParallelGateway_4">
      <incoming>SequenceFlow_12</incoming>
      <incoming>SequenceFlow_13</incoming>
      <outgoing>SequenceFlow_14</outgoing>
    </parallelGateway>
    <startEvent id="StartEvent_1" name="Open E-Shop Homepage">
      <outgoing>SequenceFlow_1</outgoing>
    </startEvent>
    <endEvent id="EndEvent_1" name="Close E-Shop Homepage">
      <incoming>SequenceFlow_23</incoming>
    </endEvent>
    <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="ManualTask_1"/>
    <sequenceFlow id="SequenceFlow_2" sourceRef="ManualTask_1" targetRef="ServiceTask_1"/>
    <sequenceFlow id="SequenceFlow_3" sourceRef="ServiceTask_1" targetRef="ExclusiveGateway_1"/>
    <sequenceFlow id="SequenceFlow_4" sourceRef="ManualTask_2" targetRef="ManualTask_3"/>
    <sequenceFlow id="SequenceFlow_5" sourceRef="ManualTask_3" targetRef="ManualTask_4"/>
    <sequenceFlow id="SequenceFlow_6" sourceRef="ManualTask_4" targetRef="ManualTask_5"/>
    <sequenceFlow id="SequenceFlow_7" sourceRef="ManualTask_5" targetRef="ExclusiveGateway_2"/>
    <sequenceFlow id="SequenceFlow_8" sourceRef="ParallelGateway_1" targetRef="ServiceTask_2"/>
    <sequenceFlow id="SequenceFlow_9" sourceRef="ParallelGateway_1" targetRef="ServiceTask_3"/>
    <sequenceFlow id="SequenceFlow_10" sourceRef="ParallelGateway_2" targetRef="ServiceTask_4"/>
    <sequenceFlow id="SequenceFlow_11" sourceRef="ManualTask_6" targetRef="ParallelGateway_3"/>
    <sequenceFlow id="SequenceFlow_12" sourceRef="ServiceTask_2" targetRef="ParallelGateway_4"/>
    <sequenceFlow id="SequenceFlow_13" sourceRef="ServiceTask_3" targetRef="ParallelGateway_4"/>
    <sequenceFlow id="SequenceFlow_14" sourceRef="ParallelGateway_4" targetRef="ManualTask_6"/>
    <sequenceFlow id="SequenceFlow_15" sourceRef="ParallelGateway_3" targetRef="ManualTask_7"/>
    <sequenceFlow id="SequenceFlow_16" sourceRef="ManualTask_7" targetRef="ExclusiveGateway_3"/>
    <sequenceFlow id="SequenceFlow_17" sourceRef="ManualTask_8" targetRef="ExclusiveGateway_4"/>
    <sequenceFlow id="SequenceFlow_18" sourceRef="ExclusiveGateway_4" targetRef="ParallelGateway_2"/>
    <sequenceFlow id="SequenceFlow_19" name="Yes" sourceRef="ExclusiveGateway_3" targetRef="ExclusiveGateway_4"/>
    <sequenceFlow id="SequenceFlow_20" name="No" sourceRef="ExclusiveGateway_3" targetRef="ManualTask_8"/>
    <sequenceFlow id="SequenceFlow_21" name="Yes" sourceRef="ExclusiveGateway_2" targetRef="ParallelGateway_1"/>
    <sequenceFlow id="SequenceFlow_22" sourceRef="ServiceTask_4" targetRef="ExclusiveGateway_5"/>
    <sequenceFlow id="SequenceFlow_23" sourceRef="ExclusiveGateway_5" targetRef="EndEvent_1"/>
    <sequenceFlow id="SequenceFlow_24" sourceRef="ExclusiveGateway_6" targetRef="ManualTask_2"/>
    <sequenceFlow id="SequenceFlow_25" name="Yes" sourceRef="ExclusiveGateway_1" targetRef="ExclusiveGateway_6"/>
    <sequenceFlow id="SequenceFlow_26" sourceRef="ParallelGateway_3" targetRef="Task_1"/>
    <sequenceFlow id="SequenceFlow_27" sourceRef="Task_1" targetRef="ParallelGateway_2"/>
    <sequenceFlow id="SequenceFlow_28" name="No" sourceRef="ExclusiveGateway_2" targetRef="ExclusiveGateway_6"/>
    <sequenceFlow id="SequenceFlow_29" name="No" sourceRef="ExclusiveGateway_1" targetRef="ExclusiveGateway_5"/>
  </process>
</definitions>