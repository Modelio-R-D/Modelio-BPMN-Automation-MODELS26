<?xml version="1.0" ?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://www.omg.org/spec/BPMN/20100524/MODEL">
  <process id="Process_1">
    <userTask id="UserTask_1" name="Send sketches to an artist">
      <incoming>SequenceFlow_4</incoming>
      <outgoing>SequenceFlow_1</outgoing>
    </userTask>
    <userTask id="UserTask_2" name="Tell artist to change">
      <incoming>SequenceFlow_29</incoming>
      <outgoing>SequenceFlow_3</outgoing>
    </userTask>
    <userTask id="UserTask_3" name="Choose the color">
      <incoming>SequenceFlow_6</incoming>
      <outgoing>SequenceFlow_7</outgoing>
    </userTask>
    <userTask id="UserTask_4" name="Check color level">
      <incoming>SequenceFlow_8</incoming>
      <outgoing>SequenceFlow_9</outgoing>
    </userTask>
    <userTask id="UserTask_5" name="Order color">
      <incoming>SequenceFlow_13</incoming>
      <outgoing>SequenceFlow_15</outgoing>
    </userTask>
    <userTask id="UserTask_6" name="Turn on the printer">
      <incoming>SequenceFlow_16</incoming>
      <outgoing>SequenceFlow_17</outgoing>
    </userTask>
    <userTask id="UserTask_7" name="Generate gcode file">
      <incoming>SequenceFlow_18</incoming>
      <outgoing>SequenceFlow_23</outgoing>
    </userTask>
    <userTask id="UserTask_8" name="Print the model">
      <incoming>SequenceFlow_24</incoming>
      <outgoing>SequenceFlow_25</outgoing>
    </userTask>
    <receiveTask id="ReceiveTask_1" name="Receive result">
      <incoming>SequenceFlow_1</incoming>
      <outgoing>SequenceFlow_2</outgoing>
    </receiveTask>
    <receiveTask id="ReceiveTask_2" name="Receive status">
      <incoming>SequenceFlow_21</incoming>
      <outgoing>SequenceFlow_19</outgoing>
    </receiveTask>
    <receiveTask id="ReceiveTask_3" name="Receive order confirmation">
      <incoming>SequenceFlow_15</incoming>
      <outgoing>SequenceFlow_27</outgoing>
    </receiveTask>
    <manualTask id="ManualTask_1" name="Put it on shopping list">
      <incoming>SequenceFlow_10</incoming>
      <outgoing>SequenceFlow_12</outgoing>
    </manualTask>
    <manualTask id="ManualTask_2" name="Color received">
      <incoming>SequenceFlow_27</incoming>
      <outgoing>SequenceFlow_28</outgoing>
    </manualTask>
    <exclusiveGateway id="ExclusiveGateway_1" name="Satisfied with result?">
      <incoming>SequenceFlow_2</incoming>
      <outgoing>SequenceFlow_6</outgoing>
      <outgoing>SequenceFlow_29</outgoing>
    </exclusiveGateway>
    <exclusiveGateway id="ExclusiveGateway_2">
      <incoming>SequenceFlow_3</incoming>
      <incoming>SequenceFlow_5</incoming>
      <outgoing>SequenceFlow_4</outgoing>
    </exclusiveGateway>
    <exclusiveGateway id="ExclusiveGateway_3" name="In stock?">
      <incoming>SequenceFlow_7</incoming>
      <outgoing>SequenceFlow_8</outgoing>
      <outgoing>SequenceFlow_13</outgoing>
    </exclusiveGateway>
    <exclusiveGateway id="ExclusiveGateway_4" name="Under 100g?">
      <incoming>SequenceFlow_9</incoming>
      <outgoing>SequenceFlow_10</outgoing>
      <outgoing>SequenceFlow_11</outgoing>
    </exclusiveGateway>
    <exclusiveGateway id="ExclusiveGateway_5">
      <incoming>SequenceFlow_11</incoming>
      <incoming>SequenceFlow_12</incoming>
      <outgoing>SequenceFlow_14</outgoing>
    </exclusiveGateway>
    <exclusiveGateway id="ExclusiveGateway_6">
      <incoming>SequenceFlow_14</incoming>
      <incoming>SequenceFlow_28</incoming>
      <outgoing>SequenceFlow_16</outgoing>
    </exclusiveGateway>
    <exclusiveGateway id="ExclusiveGateway_7" name="Heated?">
      <incoming>SequenceFlow_19</incoming>
      <outgoing>SequenceFlow_22</outgoing>
      <outgoing>SequenceFlow_26</outgoing>
    </exclusiveGateway>
    <exclusiveGateway id="ExclusiveGateway_8">
      <incoming>SequenceFlow_20</incoming>
      <incoming>SequenceFlow_26</incoming>
      <outgoing>SequenceFlow_21</outgoing>
    </exclusiveGateway>
    <parallelGateway id="ParallelGateway_1">
      <incoming>SequenceFlow_17</incoming>
      <outgoing>SequenceFlow_18</outgoing>
      <outgoing>SequenceFlow_20</outgoing>
    </parallelGateway>
    <parallelGateway id="ParallelGateway_2">
      <incoming>SequenceFlow_22</incoming>
      <incoming>SequenceFlow_23</incoming>
      <outgoing>SequenceFlow_24</outgoing>
    </parallelGateway>
    <startEvent id="StartEvent_1" name="Create a 3D model">
      <outgoing>SequenceFlow_5</outgoing>
    </startEvent>
    <endEvent id="EndEvent_1" name="Model printed">
      <incoming>SequenceFlow_25</incoming>
    </endEvent>
    <sequenceFlow id="SequenceFlow_1" sourceRef="UserTask_1" targetRef="ReceiveTask_1"/>
    <sequenceFlow id="SequenceFlow_2" sourceRef="ReceiveTask_1" targetRef="ExclusiveGateway_1"/>
    <sequenceFlow id="SequenceFlow_3" sourceRef="UserTask_2" targetRef="ExclusiveGateway_2"/>
    <sequenceFlow id="SequenceFlow_4" sourceRef="ExclusiveGateway_2" targetRef="UserTask_1"/>
    <sequenceFlow id="SequenceFlow_5" sourceRef="StartEvent_1" targetRef="ExclusiveGateway_2"/>
    <sequenceFlow id="SequenceFlow_6" name="Yes" sourceRef="ExclusiveGateway_1" targetRef="UserTask_3"/>
    <sequenceFlow id="SequenceFlow_7" sourceRef="UserTask_3" targetRef="ExclusiveGateway_3"/>
    <sequenceFlow id="SequenceFlow_8" name="Yes" sourceRef="ExclusiveGateway_3" targetRef="UserTask_4"/>
    <sequenceFlow id="SequenceFlow_9" sourceRef="UserTask_4" targetRef="ExclusiveGateway_4"/>
    <sequenceFlow id="SequenceFlow_10" name="Yes" sourceRef="ExclusiveGateway_4" targetRef="ManualTask_1"/>
    <sequenceFlow id="SequenceFlow_11" name="No" sourceRef="ExclusiveGateway_4" targetRef="ExclusiveGateway_5"/>
    <sequenceFlow id="SequenceFlow_12" sourceRef="ManualTask_1" targetRef="ExclusiveGateway_5"/>
    <sequenceFlow id="SequenceFlow_13" name="No" sourceRef="ExclusiveGateway_3" targetRef="UserTask_5"/>
    <sequenceFlow id="SequenceFlow_14" sourceRef="ExclusiveGateway_5" targetRef="ExclusiveGateway_6"/>
    <sequenceFlow id="SequenceFlow_15" sourceRef="UserTask_5" targetRef="ReceiveTask_3"/>
    <sequenceFlow id="SequenceFlow_16" sourceRef="ExclusiveGateway_6" targetRef="UserTask_6"/>
    <sequenceFlow id="SequenceFlow_17" sourceRef="UserTask_6" targetRef="ParallelGateway_1"/>
    <sequenceFlow id="SequenceFlow_18" sourceRef="ParallelGateway_1" targetRef="UserTask_7"/>
    <sequenceFlow id="SequenceFlow_19" sourceRef="ReceiveTask_2" targetRef="ExclusiveGateway_7"/>
    <sequenceFlow id="SequenceFlow_20" sourceRef="ParallelGateway_1" targetRef="ExclusiveGateway_8"/>
    <sequenceFlow id="SequenceFlow_21" sourceRef="ExclusiveGateway_8" targetRef="ReceiveTask_2"/>
    <sequenceFlow id="SequenceFlow_22" name="Yes" sourceRef="ExclusiveGateway_7" targetRef="ParallelGateway_2"/>
    <sequenceFlow id="SequenceFlow_23" sourceRef="UserTask_7" targetRef="ParallelGateway_2"/>
    <sequenceFlow id="SequenceFlow_24" sourceRef="ParallelGateway_2" targetRef="UserTask_8"/>
    <sequenceFlow id="SequenceFlow_25" sourceRef="UserTask_8" targetRef="EndEvent_1"/>
    <sequenceFlow id="SequenceFlow_26" name="No" sourceRef="ExclusiveGateway_7" targetRef="ExclusiveGateway_8"/>
    <sequenceFlow id="SequenceFlow_27" sourceRef="ReceiveTask_3" targetRef="ManualTask_2"/>
    <sequenceFlow id="SequenceFlow_28" sourceRef="ManualTask_2" targetRef="ExclusiveGateway_6"/>
    <sequenceFlow id="SequenceFlow_29" name="No" sourceRef="ExclusiveGateway_1" targetRef="UserTask_2"/>
  </process>
</definitions>