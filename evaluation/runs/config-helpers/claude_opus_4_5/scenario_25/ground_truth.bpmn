    <sequenceFlow id="SequenceFlow_18" name="No" sourceRef="ExclusiveGateway_1" targetRef="ServiceTask_3"/>
    <sequenceFlow id="SequenceFlow_19" sourceRef="ExclusiveGateway_7" targetRef="ExclusiveGateway_6"/>
    <sequenceFlow id="SequenceFlow_20" sourceRef="UserTask_9" targetRef="ExclusiveGateway_7"/>
    <sequenceFlow id="SequenceFlow_21" sourceRef="ExclusiveGateway_8" targetRef="ExclusiveGateway_7"/>
    <sequenceFlow id="SequenceFlow_22" sourceRef="UserTask_8" targetRef="IntermediateCatchEvent_1"/>
    <sequenceFlow id="SequenceFlow_23" sourceRef="ParallelGateway_2" targetRef="ExclusiveGateway_1"/>
    <sequenceFlow id="SequenceFlow_24" sourceRef="UserTask_1" targetRef="ExclusiveGateway_9"/>
    <sequenceFlow id="SequenceFlow_25" sourceRef="StartEvent_1" targetRef="ExclusiveGateway_5"/>
    <sequenceFlow id="SequenceFlow_26" sourceRef="UserTask_2" targetRef="ExclusiveGateway_10"/>
    <sequenceFlow id="SequenceFlow_27" name="No" sourceRef="ExclusiveGateway_9" targetRef="ExclusiveGateway_10"/>
    <sequenceFlow id="SequenceFlow_28" name="Yes" sourceRef="ExclusiveGateway_9" targetRef="UserTask_2"/>
    <sequenceFlow id="SequenceFlow_29" sourceRef="ExclusiveGateway_10" targetRef="ParallelGateway_1"/>
