      <incoming>SequenceFlow_20</incoming>
      <incoming>SequenceFlow_21</incoming>
      <outgoing>SequenceFlow_19</outgoing>
    </exclusiveGateway>
    <exclusiveGateway id="ExclusiveGateway_8">
      <incoming>SequenceFlow_30</incoming>
      <incoming>SequenceFlow_36</incoming>
      <outgoing>SequenceFlow_21</outgoing>
    </exclusiveGateway>
    <exclusiveGateway id="ExclusiveGateway_9" name="Report Required?">
      <incoming>SequenceFlow_24</incoming>
      <outgoing>SequenceFlow_27</outgoing>
      <outgoing>SequenceFlow_28</outgoing>
    </exclusiveGateway>
    <exclusiveGateway id="ExclusiveGateway_10">
      <incoming>SequenceFlow_26</incoming>
      <incoming>SequenceFlow_27</incoming>
      <outgoing>SequenceFlow_29</outgoing>
    </exclusiveGateway>
    <exclusiveGateway id="ExclusiveGateway_11" name="Is any job offer received?">
      <incoming>SequenceFlow_32</incoming>
      <outgoing>SequenceFlow_33</outgoing>
      <outgoing>SequenceFlow_34</outgoing>
    </exclusiveGateway>
    <exclusiveGateway id="ExclusiveGateway_12">
      <incoming>SequenceFlow_7</incoming>
      <incoming>SequenceFlow_34</incoming>
      <outgoing>SequenceFlow_31</outgoing>
    </exclusiveGateway>
    <parallelGateway id="ParallelGateway_1">
      <incoming>SequenceFlow_29</incoming>
      <outgoing>SequenceFlow_1</outgoing>
      <outgoing>SequenceFlow_2</outgoing>
    </parallelGateway>
    <parallelGateway id="ParallelGateway_2">
      <incoming>SequenceFlow_3</incoming>
      <incoming>SequenceFlow_4</incoming>
      <outgoing>SequenceFlow_23</outgoing>
    </parallelGateway>
    <parallelGateway id="ParallelGateway_3">
      <incoming>SequenceFlow_10</incoming>
      <outgoing>SequenceFlow_11</outgoing>
      <outgoing>SequenceFlow_13</outgoing>
    </parallelGateway>
    <parallelGateway id="ParallelGateway_4">
      <incoming>SequenceFlow_12</incoming>
      <incoming>SequenceFlow_15</incoming>
      <outgoing>SequenceFlow_37</outgoing>
    </parallelGateway>
    <startEvent id="StartEvent_1" name="Job needed">
      <outgoing>SequenceFlow_25</outgoing>
    </startEvent>
    <endEvent id="EndEvent_1" name="Job found">
      <incoming>SequenceFlow_39</incoming>
    </endEvent>
    <intermediateCatchEvent id="IntermediateCatchEvent_1" name="One year">
      <timerEventDefinition id="timer_1"/>
      <incoming>SequenceFlow_22</incoming>
      <outgoing>SequenceFlow_38</outgoing>
    </intermediateCatchEvent>
    <sequenceFlow id="SequenceFlow_1" sourceRef="ParallelGateway_1" targetRef="ServiceTask_1"/>
    <sequenceFlow id="SequenceFlow_2" sourceRef="ParallelGateway_1" targetRef="ServiceTask_2"/>
    <sequenceFlow id="SequenceFlow_3" sourceRef="ServiceTask_1" targetRef="ParallelGateway_2"/>
    <sequenceFlow id="SequenceFlow_4" sourceRef="ServiceTask_2" targetRef="ParallelGateway_2"/>
