<?xml version="1.0" ?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://www.omg.org/spec/BPMN/20100524/MODEL">
  <process id="Process_1">
    <userTask id="UserTask_1" name="Submit job application">
      <incoming>SequenceFlow_33</incoming>
      <outgoing>SequenceFlow_24</outgoing>
    </userTask>
    <userTask id="UserTask_2" name="Report">
      <incoming>SequenceFlow_28</incoming>
      <outgoing>SequenceFlow_26</outgoing>
    </userTask>
    <userTask id="UserTask_3" name="Interview candidate">
      <incoming>SequenceFlow_31</incoming>
      <outgoing>SequenceFlow_8</outgoing>
    </userTask>
    <userTask id="UserTask_4" name="Evaluate job application">
      <incoming>SequenceFlow_5</incoming>
      <outgoing>SequenceFlow_6</outgoing>
    </userTask>
    <userTask id="UserTask_5" name="Enter probation phase">
      <incoming>SequenceFlow_9</incoming>
      <outgoing>SequenceFlow_10</outgoing>
    </userTask>
    <userTask id="UserTask_6" name="Evaluate company">
      <incoming>SequenceFlow_11</incoming>
      <outgoing>SequenceFlow_12</outgoing>
    </userTask>
    <userTask id="UserTask_7" name="Evaluate employee">
      <incoming>SequenceFlow_13</incoming>
      <outgoing>SequenceFlow_15</outgoing>
    </userTask>
    <userTask id="UserTask_8" name="Do temp-to-perm">
      <incoming>SequenceFlow_14</incoming>
      <outgoing>SequenceFlow_22</outgoing>
    </userTask>
    <userTask id="UserTask_9" name="Send rejection Email">
      <incoming>SequenceFlow_17</incoming>
      <outgoing>SequenceFlow_20</outgoing>
    </userTask>
    <serviceTask id="ServiceTask_1" name="Confirm job application">
      <incoming>SequenceFlow_1</incoming>
      <outgoing>SequenceFlow_3</outgoing>
    </serviceTask>
    <serviceTask id="ServiceTask_2" name="Process job application">
      <incoming>SequenceFlow_2</incoming>
      <outgoing>SequenceFlow_4</outgoing>
    </serviceTask>
    <serviceTask id="ServiceTask_3" name="Send autogenerated rejection Email">
      <incoming>SequenceFlow_18</incoming>
      <outgoing>SequenceFlow_16</outgoing>
    </serviceTask>
    <serviceTask id="ServiceTask_4" name="Publish applicant's review">
      <incoming>SequenceFlow_38</incoming>
      <outgoing>SequenceFlow_39</outgoing>
    </serviceTask>
    <exclusiveGateway id="ExclusiveGateway_1" name="Is job application accepted?">
      <incoming>SequenceFlow_23</incoming>
      <outgoing>SequenceFlow_5</outgoing>
      <outgoing>SequenceFlow_18</outgoing>
    </exclusiveGateway>
    <exclusiveGateway id="ExclusiveGateway_2" name="Is job application accepted?">
      <incoming>SequenceFlow_6</incoming>
      <outgoing>SequenceFlow_7</outgoing>
      <outgoing>SequenceFlow_17</outgoing>
    </exclusiveGateway>
    <exclusiveGateway id="ExclusiveGateway_3" name="Is candidate selected?">
      <incoming>SequenceFlow_8</incoming>
      <outgoing>SequenceFlow_9</outgoing>
      <outgoing>SequenceFlow_36</outgoing>
    </exclusiveGateway>
    <exclusiveGateway id="ExclusiveGateway_4" name="Is one of the rating results C or less?">
      <incoming>SequenceFlow_37</incoming>
      <outgoing>SequenceFlow_14</outgoing>
      <outgoing>SequenceFlow_35</outgoing>
    </exclusiveGateway>
    <exclusiveGateway id="ExclusiveGateway_5">
      <incoming>SequenceFlow_25</incoming>
      <incoming>SequenceFlow_35</incoming>
      <outgoing>SequenceFlow_30</outgoing>
