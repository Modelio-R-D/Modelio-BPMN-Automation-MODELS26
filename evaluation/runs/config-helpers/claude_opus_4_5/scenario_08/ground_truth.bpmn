<?xml version="1.0" ?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://www.omg.org/spec/BPMN/20100524/MODEL">
  <process id="Process_1">
    <task id="Task_1" name="Propose corrective actions">
      <incoming>SequenceFlow_5</incoming>
      <outgoing>SequenceFlow_16</outgoing>
    </task>
    <task id="Task_2" name="Log report into tracking system">
      <incoming>SequenceFlow_15</incoming>
      <outgoing>SequenceFlow_7</outgoing>
    </task>
    <task id="Task_3" name="Close incident report">
      <incoming>SequenceFlow_9</incoming>
      <outgoing>SequenceFlow_13</outgoing>
    </task>
    <task id="Task_4" name="Change policy">
      <incoming>SequenceFlow_11</incoming>
      <outgoing>SequenceFlow_1</outgoing>
    </task>
    <task id="Task_5" name="Assign report to appropriate team">
      <incoming>SequenceFlow_7</incoming>
      <outgoing>SequenceFlow_18</outgoing>
    </task>
    <task id="Task_6" name="Report incident">
      <incoming>SequenceFlow_4</incoming>
      <outgoing>SequenceFlow_15</outgoing>
    </task>
    <task id="Task_7" name="Conduct training">
      <incoming>SequenceFlow_20</incoming>
      <outgoing>SequenceFlow_17</outgoing>
    </task>
    <task id="Task_8" name="Gather necessary information">
      <incoming>SequenceFlow_8</incoming>
      <outgoing>SequenceFlow_6</outgoing>
    </task>
    <task id="Task_9" name="Identify cause of incident">
      <incoming>SequenceFlow_19</incoming>
      <outgoing>SequenceFlow_12</outgoing>
    </task>
    <task id="Task_10" name="Notify all stakeholders">
      <incoming>SequenceFlow_13</incoming>
      <outgoing>SequenceFlow_10</outgoing>
    </task>
    <task id="Task_11" name="Implement fix">
      <incoming>SequenceFlow_2</incoming>
      <outgoing>SequenceFlow_14</outgoing>
    </task>
    <task id="Task_12" name="Conduct follow-up">
      <incoming>SequenceFlow_3</incoming>
      <outgoing>SequenceFlow_9</outgoing>
    </task>
    <exclusiveGateway id="ExclusiveGateway_1">
      <incoming>SequenceFlow_1</incoming>
      <incoming>SequenceFlow_14</incoming>
      <incoming>SequenceFlow_17</incoming>
      <outgoing>SequenceFlow_3</outgoing>
    </exclusiveGateway>
    <exclusiveGateway id="ExclusiveGateway_2">
      <incoming>SequenceFlow_16</incoming>
      <outgoing>SequenceFlow_2</outgoing>
      <outgoing>SequenceFlow_11</outgoing>
      <outgoing>SequenceFlow_20</outgoing>
    </exclusiveGateway>
    <parallelGateway id="ParallelGateway_1">
      <incoming>SequenceFlow_6</incoming>
      <incoming>SequenceFlow_12</incoming>
      <outgoing>SequenceFlow_5</outgoing>
    </parallelGateway>
    <parallelGateway id="ParallelGateway_2">
      <incoming>SequenceFlow_18</incoming>
      <outgoing>SequenceFlow_8</outgoing>
      <outgoing>SequenceFlow_19</outgoing>
    </parallelGateway>
    <startEvent id="StartEvent_1" name="start">
      <outgoing>SequenceFlow_4</outgoing>
    </startEvent>
    <endEvent id="EndEvent_1" name="end">
      <incoming>SequenceFlow_10</incoming>
    </endEvent>
    <sequenceFlow id="SequenceFlow_1" sourceRef="Task_4" targetRef="ExclusiveGateway_1"/>
    <sequenceFlow id="SequenceFlow_2" sourceRef="ExclusiveGateway_2" targetRef="Task_11"/>
    <sequenceFlow id="SequenceFlow_3" sourceRef="ExclusiveGateway_1" targetRef="Task_12"/>
    <sequenceFlow id="SequenceFlow_4" sourceRef="StartEvent_1" targetRef="Task_6"/>
    <sequenceFlow id="SequenceFlow_5" sourceRef="ParallelGateway_1" targetRef="Task_1"/>
    <sequenceFlow id="SequenceFlow_6" sourceRef="Task_8" targetRef="ParallelGateway_1"/>
    <sequenceFlow id="SequenceFlow_7" sourceRef="Task_2" targetRef="Task_5"/>
    <sequenceFlow id="SequenceFlow_8" sourceRef="ParallelGateway_2" targetRef="Task_8"/>
    <sequenceFlow id="SequenceFlow_9" sourceRef="Task_12" targetRef="Task_3"/>
    <sequenceFlow id="SequenceFlow_10" sourceRef="Task_10" targetRef="EndEvent_1"/>
    <sequenceFlow id="SequenceFlow_11" sourceRef="ExclusiveGateway_2" targetRef="Task_4"/>
    <sequenceFlow id="SequenceFlow_12" sourceRef="Task_9" targetRef="ParallelGateway_1"/>
    <sequenceFlow id="SequenceFlow_13" sourceRef="Task_3" targetRef="Task_10"/>
    <sequenceFlow id="SequenceFlow_14" sourceRef="Task_11" targetRef="ExclusiveGateway_1"/>
    <sequenceFlow id="SequenceFlow_15" sourceRef="Task_6" targetRef="Task_2"/>
    <sequenceFlow id="SequenceFlow_16" sourceRef="Task_1" targetRef="ExclusiveGateway_2"/>
    <sequenceFlow id="SequenceFlow_17" sourceRef="Task_7" targetRef="ExclusiveGateway_1"/>
    <sequenceFlow id="SequenceFlow_18" sourceRef="Task_5" targetRef="ParallelGateway_2"/>
    <sequenceFlow id="SequenceFlow_19" sourceRef="ParallelGateway_2" targetRef="Task_9"/>
    <sequenceFlow id="SequenceFlow_20" sourceRef="ExclusiveGateway_2" targetRef="Task_7"/>
  </process>
</definitions>