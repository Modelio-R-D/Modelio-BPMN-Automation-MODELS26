<?xml version="1.0" ?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://www.omg.org/spec/BPMN/20100524/MODEL">
  <process id="Process_1">
    <userTask id="UserTask_1" name="Query the next shop">
      <incoming>SequenceFlow_2</incoming>
      <outgoing>SequenceFlow_4</outgoing>
    </userTask>
    <userTask id="UserTask_2" name="Ask about quantity, price and deadline">
      <incoming>SequenceFlow_4</incoming>
      <outgoing>SequenceFlow_5</outgoing>
    </userTask>
    <serviceTask id="ServiceTask_1" name="Create a list of the parts">
      <incoming>SequenceFlow_7</incoming>
      <outgoing>SequenceFlow_3</outgoing>
    </serviceTask>
    <serviceTask id="ServiceTask_2" name="Reorder the cheapest part">
      <incoming>SequenceFlow_25</incoming>
      <outgoing>SequenceFlow_21</outgoing>
    </serviceTask>
    <serviceTask id="ServiceTask_3" name="Reorder the part as fast as possible">
      <incoming>SequenceFlow_26</incoming>
      <outgoing>SequenceFlow_20</outgoing>
    </serviceTask>
    <manualTask id="ManualTask_1" name="Receive first batch of parts">
      <incoming>SequenceFlow_11</incoming>
      <outgoing>SequenceFlow_14</outgoing>
    </manualTask>
    <manualTask id="ManualTask_2" name="Receive second batch of parts">
      <incoming>SequenceFlow_12</incoming>
      <outgoing>SequenceFlow_15</outgoing>
    </manualTask>
    <manualTask id="ManualTask_3" name="Receive third batch of parts">
      <incoming>SequenceFlow_13</incoming>
      <outgoing>SequenceFlow_16</outgoing>
    </manualTask>
    <manualTask id="ManualTask_4" name="Start/Continue building">
      <incoming>SequenceFlow_17</incoming>
      <incoming>SequenceFlow_29</incoming>
      <outgoing>SequenceFlow_18</outgoing>
    </manualTask>
    <manualTask id="ManualTask_5" name="Complain to the friends">
      <incoming>SequenceFlow_27</incoming>
      <outgoing>SequenceFlow_22</outgoing>
    </manualTask>
    <exclusiveGateway id="ExclusiveGateway_1">
      <incoming>SequenceFlow_1</incoming>
      <incoming>SequenceFlow_9</incoming>
      <outgoing>SequenceFlow_2</outgoing>
    </exclusiveGateway>
    <exclusiveGateway id="ExclusiveGateway_2" name="Terms acceptable?">
      <incoming>SequenceFlow_5</incoming>
      <outgoing>SequenceFlow_6</outgoing>
      <outgoing>SequenceFlow_7</outgoing>
    </exclusiveGateway>
    <exclusiveGateway id="ExclusiveGateway_3">
      <incoming>SequenceFlow_3</incoming>
      <incoming>SequenceFlow_6</incoming>
      <outgoing>SequenceFlow_8</outgoing>
    </exclusiveGateway>
    <exclusiveGateway id="ExclusiveGateway_4" name="More parts needed?">
      <incoming>SequenceFlow_8</incoming>
      <outgoing>SequenceFlow_9</outgoing>
      <outgoing>SequenceFlow_10</outgoing>
    </exclusiveGateway>
    <exclusiveGateway id="ExclusiveGateway_5" name="Any stock falls?">
      <incoming>SequenceFlow_18</incoming>
      <outgoing>SequenceFlow_19</outgoing>
      <outgoing>SequenceFlow_24</outgoing>
    </exclusiveGateway>
    <exclusiveGateway id="ExclusiveGateway_6">
      <incoming>SequenceFlow_23</incoming>
      <incoming>SequenceFlow_24</incoming>
      <outgoing>SequenceFlow_28</outgoing>
    </exclusiveGateway>
    <exclusiveGateway id="ExclusiveGateway_7" name="How much is the stock fall?">
      <incoming>SequenceFlow_19</incoming>
      <outgoing>SequenceFlow_25</outgoing>
      <outgoing>SequenceFlow_26</outgoing>
      <outgoing>SequenceFlow_27</outgoing>
    </exclusiveGateway>
    <exclusiveGateway id="ExclusiveGateway_8">
      <incoming>SequenceFlow_20</incoming>
      <incoming>SequenceFlow_21</incoming>
      <incoming>SequenceFlow_22</incoming>
      <outgoing>SequenceFlow_23</outgoing>
    </exclusiveGateway>
    <exclusiveGateway id="ExclusiveGateway_9" name="Contract fullfilled?">
      <incoming>SequenceFlow_28</incoming>
      <outgoing>SequenceFlow_29</outgoing>
      <outgoing>SequenceFlow_30</outgoing>
    </exclusiveGateway>
    <parallelGateway id="ParallelGateway_1">
      <incoming>SequenceFlow_10</incoming>
      <outgoing>SequenceFlow_11</outgoing>
      <outgoing>SequenceFlow_12</outgoing>
      <outgoing>SequenceFlow_13</outgoing>
    </parallelGateway>
    <complexGateway id="ComplexGateway_1" name="First parts arrived">
      <incoming>SequenceFlow_14</incoming>
      <incoming>SequenceFlow_15</incoming>
      <incoming>SequenceFlow_16</incoming>
      <outgoing>SequenceFlow_17</outgoing>
    </complexGateway>
    <startEvent id="StartEvent_1" name="Contract project received">
      <outgoing>SequenceFlow_1</outgoing>
    </startEvent>
    <endEvent id="EndEvent_1" name="Project completed">
      <incoming>SequenceFlow_30</incoming>
    </endEvent>
    <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="ExclusiveGateway_1"/>
    <sequenceFlow id="SequenceFlow_2" sourceRef="ExclusiveGateway_1" targetRef="UserTask_1"/>
    <sequenceFlow id="SequenceFlow_3" sourceRef="ServiceTask_1" targetRef="ExclusiveGateway_3"/>
    <sequenceFlow id="SequenceFlow_4" sourceRef="UserTask_1" targetRef="UserTask_2"/>
    <sequenceFlow id="SequenceFlow_5" sourceRef="UserTask_2" targetRef="ExclusiveGateway_2"/>
    <sequenceFlow id="SequenceFlow_6" name="No" sourceRef="ExclusiveGateway_2" targetRef="ExclusiveGateway_3"/>
    <sequenceFlow id="SequenceFlow_7" name="Yes" sourceRef="ExclusiveGateway_2" targetRef="ServiceTask_1"/>
    <sequenceFlow id="SequenceFlow_8" sourceRef="ExclusiveGateway_3" targetRef="ExclusiveGateway_4"/>
    <sequenceFlow id="SequenceFlow_9" name="Yes" sourceRef="ExclusiveGateway_4" targetRef="ExclusiveGateway_1"/>
    <sequenceFlow id="SequenceFlow_10" name="No" sourceRef="ExclusiveGateway_4" targetRef="ParallelGateway_1"/>
    <sequenceFlow id="SequenceFlow_11" sourceRef="ParallelGateway_1" targetRef="ManualTask_1"/>
    <sequenceFlow id="SequenceFlow_12" sourceRef="ParallelGateway_1" targetRef="ManualTask_2"/>
    <sequenceFlow id="SequenceFlow_13" sourceRef="ParallelGateway_1" targetRef="ManualTask_3"/>
    <sequenceFlow id="SequenceFlow_14" sourceRef="ManualTask_1" targetRef="ComplexGateway_1"/>
    <sequenceFlow id="SequenceFlow_15" sourceRef="ManualTask_2" targetRef="ComplexGateway_1"/>
    <sequenceFlow id="SequenceFlow_16" sourceRef="ManualTask_3" targetRef="ComplexGateway_1"/>
    <sequenceFlow id="SequenceFlow_17" sourceRef="ComplexGateway_1" targetRef="ManualTask_4"/>
    <sequenceFlow id="SequenceFlow_18" sourceRef="ManualTask_4" targetRef="ExclusiveGateway_5"/>
    <sequenceFlow id="SequenceFlow_19" name="Yes" sourceRef="ExclusiveGateway_5" targetRef="ExclusiveGateway_7"/>
    <sequenceFlow id="SequenceFlow_20" sourceRef="ServiceTask_3" targetRef="ExclusiveGateway_8"/>
    <sequenceFlow id="SequenceFlow_21" sourceRef="ServiceTask_2" targetRef="ExclusiveGateway_8"/>
    <sequenceFlow id="SequenceFlow_22" sourceRef="ManualTask_5" targetRef="ExclusiveGateway_8"/>
    <sequenceFlow id="SequenceFlow_23" sourceRef="ExclusiveGateway_8" targetRef="ExclusiveGateway_6"/>
    <sequenceFlow id="SequenceFlow_24" name="No" sourceRef="ExclusiveGateway_5" targetRef="ExclusiveGateway_6"/>
    <sequenceFlow id="SequenceFlow_25" name="Below 5" sourceRef="ExclusiveGateway_7" targetRef="ServiceTask_2"/>
    <sequenceFlow id="SequenceFlow_26" name="Below 3" sourceRef="ExclusiveGateway_7" targetRef="ServiceTask_3"/>
    <sequenceFlow id="SequenceFlow_27" name="Zero" sourceRef="ExclusiveGateway_7" targetRef="ManualTask_5"/>
    <sequenceFlow id="SequenceFlow_28" sourceRef="ExclusiveGateway_6" targetRef="ExclusiveGateway_9"/>
    <sequenceFlow id="SequenceFlow_29" name="No" sourceRef="ExclusiveGateway_9" targetRef="ManualTask_4"/>
    <sequenceFlow id="SequenceFlow_30" name="Yes" sourceRef="ExclusiveGateway_9" targetRef="EndEvent_1"/>
  </process>
</definitions>