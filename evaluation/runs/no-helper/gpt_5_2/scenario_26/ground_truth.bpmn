<?xml version="1.0" ?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://www.omg.org/spec/BPMN/20100524/MODEL">
  <process id="Process_1">
    <serviceTask id="ServiceTask_1" name="receive confirmation from employer">
      <incoming>SequenceFlow_3</incoming>
      <outgoing>SequenceFlow_17</outgoing>
    </serviceTask>
    <serviceTask id="ServiceTask_2" name="fetch information about leave models">
      <incoming>SequenceFlow_9</incoming>
      <outgoing>SequenceFlow_11</outgoing>
    </serviceTask>
    <serviceTask id="ServiceTask_3" name="fetch information about financial support">
      <incoming>SequenceFlow_8</incoming>
      <outgoing>SequenceFlow_10</outgoing>
    </serviceTask>
    <serviceTask id="ServiceTask_4" name="check if all necessary documents gathered">
      <incoming>SequenceFlow_17</incoming>
      <outgoing>SequenceFlow_18</outgoing>
    </serviceTask>
    <manualTask id="ManualTask_1" name="select appropriate model">
      <incoming>SequenceFlow_12</incoming>
      <outgoing>SequenceFlow_25</outgoing>
    </manualTask>
    <manualTask id="ManualTask_2" name="notify employer">
      <incoming>SequenceFlow_20</incoming>
      <outgoing>SequenceFlow_2</outgoing>
    </manualTask>
    <manualTask id="ManualTask_3" name="notify social security">
      <incoming>SequenceFlow_21</incoming>
      <outgoing>SequenceFlow_1</outgoing>
    </manualTask>
    <manualTask id="ManualTask_4" name="prepare necessary documents for leave">
      <incoming>SequenceFlow_22</incoming>
      <incoming>SequenceFlow_23</incoming>
      <incoming>SequenceFlow_26</incoming>
      <outgoing>SequenceFlow_24</outgoing>
    </manualTask>
    <manualTask id="ManualTask_5" name="do maternity/paternity leave">
      <incoming>SequenceFlow_19</incoming>
      <outgoing>SequenceFlow_4</outgoing>
    </manualTask>
    <manualTask id="ManualTask_6" name="decide if extend leave or return to work">
      <incoming>SequenceFlow_4</incoming>
      <outgoing>SequenceFlow_5</outgoing>
    </manualTask>
    <manualTask id="ManualTask_7" name="apply for financial support">
      <incoming>SequenceFlow_13</incoming>
      <outgoing>SequenceFlow_14</outgoing>
    </manualTask>
    <manualTask id="ManualTask_8" name="decide if apply for financial support">
      <incoming>SequenceFlow_25</incoming>
      <outgoing>SequenceFlow_15</outgoing>
    </manualTask>
    <exclusiveGateway id="ExclusiveGateway_1">
      <incoming>SequenceFlow_5</incoming>
      <outgoing>SequenceFlow_6</outgoing>
      <outgoing>SequenceFlow_26</outgoing>
    </exclusiveGateway>
    <exclusiveGateway id="ExclusiveGateway_2">
      <incoming>SequenceFlow_15</incoming>
      <outgoing>SequenceFlow_13</outgoing>
      <outgoing>SequenceFlow_16</outgoing>
    </exclusiveGateway>
    <exclusiveGateway id="ExclusiveGateway_3">
      <incoming>SequenceFlow_14</incoming>
      <incoming>SequenceFlow_16</incoming>
      <outgoing>SequenceFlow_23</outgoing>
    </exclusiveGateway>
    <exclusiveGateway id="ExclusiveGateway_4">
      <incoming>SequenceFlow_18</incoming>
      <outgoing>SequenceFlow_19</outgoing>
      <outgoing>SequenceFlow_22</outgoing>
    </exclusiveGateway>
    <parallelGateway id="ParallelGateway_1">
      <incoming>SequenceFlow_24</incoming>
      <outgoing>SequenceFlow_20</outgoing>
      <outgoing>SequenceFlow_21</outgoing>
    </parallelGateway>
    <parallelGateway id="ParallelGateway_2">
      <incoming>SequenceFlow_1</incoming>
      <incoming>SequenceFlow_2</incoming>
      <outgoing>SequenceFlow_3</outgoing>
    </parallelGateway>
    <parallelGateway id="ParallelGateway_3">
      <incoming>SequenceFlow_7</incoming>
      <outgoing>SequenceFlow_8</outgoing>
      <outgoing>SequenceFlow_9</outgoing>
    </parallelGateway>
    <parallelGateway id="ParallelGateway_4">
      <incoming>SequenceFlow_10</incoming>
      <incoming>SequenceFlow_11</incoming>
      <outgoing>SequenceFlow_12</outgoing>
    </parallelGateway>
    <startEvent id="StartEvent_1">
      <outgoing>SequenceFlow_7</outgoing>
    </startEvent>
    <endEvent id="EndEvent_1" name="return to job">
      <incoming>SequenceFlow_6</incoming>
    </endEvent>
    <sequenceFlow id="SequenceFlow_1" sourceRef="ManualTask_3" targetRef="ParallelGateway_2"/>
    <sequenceFlow id="SequenceFlow_2" sourceRef="ManualTask_2" targetRef="ParallelGateway_2"/>
    <sequenceFlow id="SequenceFlow_3" sourceRef="ParallelGateway_2" targetRef="ServiceTask_1"/>
    <sequenceFlow id="SequenceFlow_4" sourceRef="ManualTask_5" targetRef="ManualTask_6"/>
    <sequenceFlow id="SequenceFlow_5" sourceRef="ManualTask_6" targetRef="ExclusiveGateway_1"/>
    <sequenceFlow id="SequenceFlow_6" sourceRef="ExclusiveGateway_1" targetRef="EndEvent_1"/>
    <sequenceFlow id="SequenceFlow_7" sourceRef="StartEvent_1" targetRef="ParallelGateway_3"/>
    <sequenceFlow id="SequenceFlow_8" sourceRef="ParallelGateway_3" targetRef="ServiceTask_3"/>
    <sequenceFlow id="SequenceFlow_9" sourceRef="ParallelGateway_3" targetRef="ServiceTask_2"/>
    <sequenceFlow id="SequenceFlow_10" sourceRef="ServiceTask_3" targetRef="ParallelGateway_4"/>
    <sequenceFlow id="SequenceFlow_11" sourceRef="ServiceTask_2" targetRef="ParallelGateway_4"/>
    <sequenceFlow id="SequenceFlow_12" sourceRef="ParallelGateway_4" targetRef="ManualTask_1"/>
    <sequenceFlow id="SequenceFlow_13" sourceRef="ExclusiveGateway_2" targetRef="ManualTask_7"/>
    <sequenceFlow id="SequenceFlow_14" sourceRef="ManualTask_7" targetRef="ExclusiveGateway_3"/>
    <sequenceFlow id="SequenceFlow_15" sourceRef="ManualTask_8" targetRef="ExclusiveGateway_2"/>
    <sequenceFlow id="SequenceFlow_16" sourceRef="ExclusiveGateway_2" targetRef="ExclusiveGateway_3"/>
    <sequenceFlow id="SequenceFlow_17" sourceRef="ServiceTask_1" targetRef="ServiceTask_4"/>
    <sequenceFlow id="SequenceFlow_18" sourceRef="ServiceTask_4" targetRef="ExclusiveGateway_4"/>
    <sequenceFlow id="SequenceFlow_19" sourceRef="ExclusiveGateway_4" targetRef="ManualTask_5"/>
    <sequenceFlow id="SequenceFlow_20" sourceRef="ParallelGateway_1" targetRef="ManualTask_2"/>
    <sequenceFlow id="SequenceFlow_21" sourceRef="ParallelGateway_1" targetRef="ManualTask_3"/>
    <sequenceFlow id="SequenceFlow_22" sourceRef="ExclusiveGateway_4" targetRef="ManualTask_4"/>
    <sequenceFlow id="SequenceFlow_23" sourceRef="ExclusiveGateway_3" targetRef="ManualTask_4"/>
    <sequenceFlow id="SequenceFlow_24" sourceRef="ManualTask_4" targetRef="ParallelGateway_1"/>
    <sequenceFlow id="SequenceFlow_25" sourceRef="ManualTask_1" targetRef="ManualTask_8"/>
    <sequenceFlow id="SequenceFlow_26" sourceRef="ExclusiveGateway_1" targetRef="ManualTask_4"/>
  </process>
</definitions>