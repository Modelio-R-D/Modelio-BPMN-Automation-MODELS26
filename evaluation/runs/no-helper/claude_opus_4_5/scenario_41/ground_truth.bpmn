<?xml version="1.0" ?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://www.omg.org/spec/BPMN/20100524/MODEL">
  <process id="Process_1">
    <userTask id="UserTask_1" name="Turn on bluetooth">
      <incoming>SequenceFlow_3</incoming>
      <outgoing>SequenceFlow_4</outgoing>
    </userTask>
    <userTask id="UserTask_2" name="Enter type of Machine">
      <incoming>SequenceFlow_5</incoming>
      <outgoing>SequenceFlow_1</outgoing>
    </userTask>
    <userTask id="UserTask_3" name="Enter serial number of machine">
      <incoming>SequenceFlow_1</incoming>
      <outgoing>SequenceFlow_2</outgoing>
    </userTask>
    <userTask id="UserTask_4" name="Run 'Inspect-App'">
      <incoming>SequenceFlow_4</incoming>
      <incoming>SequenceFlow_18</incoming>
      <outgoing>SequenceFlow_5</outgoing>
    </userTask>
    <userTask id="UserTask_5" name="Check the fill capacity">
      <incoming>SequenceFlow_7</incoming>
      <outgoing>SequenceFlow_8</outgoing>
    </userTask>
    <userTask id="UserTask_6" name="Leave short Feedback">
      <incoming>SequenceFlow_19</incoming>
      <incoming>SequenceFlow_21</incoming>
      <outgoing>SequenceFlow_22</outgoing>
    </userTask>
    <userTask id="UserTask_7" name="Press 'Produce' button">
      <incoming>SequenceFlow_9</incoming>
      <outgoing>SequenceFlow_10</outgoing>
    </userTask>
    <userTask id="UserTask_8" name="Press button 'Abort process'">
      <incoming>SequenceFlow_20</incoming>
      <incoming>SequenceFlow_22</incoming>
      <outgoing>SequenceFlow_11</outgoing>
    </userTask>
    <serviceTask id="ServiceTask_1" name="Connecting to device">
      <incoming>SequenceFlow_2</incoming>
      <outgoing>SequenceFlow_6</outgoing>
    </serviceTask>
    <serviceTask id="ServiceTask_2" name="Save Answers">
      <incoming>SequenceFlow_24</incoming>
      <outgoing>SequenceFlow_9</outgoing>
    </serviceTask>
    <serviceTask id="ServiceTask_3" name="Auto collect values">
      <incoming>SequenceFlow_12</incoming>
      <outgoing>SequenceFlow_15</outgoing>
    </serviceTask>
    <serviceTask id="ServiceTask_4" name="Show data">
      <incoming>SequenceFlow_13</incoming>
      <outgoing>SequenceFlow_14</outgoing>
    </serviceTask>
    <serviceTask id="ServiceTask_5" name="Present results">
      <incoming>SequenceFlow_16</incoming>
      <incoming>SequenceFlow_25</incoming>
      <outgoing>SequenceFlow_17</outgoing>
    </serviceTask>
    <exclusiveGateway id="ExclusiveGateway_1" name="Connected?">
      <incoming>SequenceFlow_6</incoming>
      <outgoing>SequenceFlow_7</outgoing>
      <outgoing>SequenceFlow_18</outgoing>
    </exclusiveGateway>
    <exclusiveGateway id="ExclusiveGateway_2" name="Is the fill level in the bootle ok?">
      <incoming>SequenceFlow_8</incoming>
      <outgoing>SequenceFlow_21</outgoing>
      <outgoing>SequenceFlow_23</outgoing>
    </exclusiveGateway>
    <exclusiveGateway id="ExclusiveGateway_3" name="Is the cap position straight?">
      <incoming>SequenceFlow_23</incoming>
      <outgoing>SequenceFlow_19</outgoing>
      <outgoing>SequenceFlow_24</outgoing>
    </exclusiveGateway>
    <exclusiveGateway id="ExclusiveGateway_4" name="Are the right bottles in the pack?">
      <incoming>SequenceFlow_10</incoming>
      <outgoing>SequenceFlow_20</outgoing>
      <outgoing>SequenceFlow_25</outgoing>
    </exclusiveGateway>
    <parallelGateway id="ParallelGateway_1">
      <incoming>SequenceFlow_11</incoming>
      <outgoing>SequenceFlow_12</outgoing>
      <outgoing>SequenceFlow_13</outgoing>
    </parallelGateway>
    <parallelGateway id="ParallelGateway_2">
      <incoming>SequenceFlow_14</incoming>
      <incoming>SequenceFlow_15</incoming>
      <outgoing>SequenceFlow_16</outgoing>
    </parallelGateway>
    <startEvent id="StartEvent_1">
      <outgoing>SequenceFlow_3</outgoing>
    </startEvent>
    <endEvent id="EndEvent_1">
      <incoming>SequenceFlow_17</incoming>
    </endEvent>
    <sequenceFlow id="SequenceFlow_1" sourceRef="UserTask_2" targetRef="UserTask_3"/>
    <sequenceFlow id="SequenceFlow_2" sourceRef="UserTask_3" targetRef="ServiceTask_1"/>
    <sequenceFlow id="SequenceFlow_3" sourceRef="StartEvent_1" targetRef="UserTask_1"/>
    <sequenceFlow id="SequenceFlow_4" sourceRef="UserTask_1" targetRef="UserTask_4"/>
    <sequenceFlow id="SequenceFlow_5" sourceRef="UserTask_4" targetRef="UserTask_2"/>
    <sequenceFlow id="SequenceFlow_6" sourceRef="ServiceTask_1" targetRef="ExclusiveGateway_1"/>
    <sequenceFlow id="SequenceFlow_7" name="yes" sourceRef="ExclusiveGateway_1" targetRef="UserTask_5"/>
    <sequenceFlow id="SequenceFlow_8" sourceRef="UserTask_5" targetRef="ExclusiveGateway_2"/>
    <sequenceFlow id="SequenceFlow_9" sourceRef="ServiceTask_2" targetRef="UserTask_7"/>
    <sequenceFlow id="SequenceFlow_10" sourceRef="UserTask_7" targetRef="ExclusiveGateway_4"/>
    <sequenceFlow id="SequenceFlow_11" sourceRef="UserTask_8" targetRef="ParallelGateway_1"/>
    <sequenceFlow id="SequenceFlow_12" sourceRef="ParallelGateway_1" targetRef="ServiceTask_3"/>
    <sequenceFlow id="SequenceFlow_13" sourceRef="ParallelGateway_1" targetRef="ServiceTask_4"/>
    <sequenceFlow id="SequenceFlow_14" sourceRef="ServiceTask_4" targetRef="ParallelGateway_2"/>
    <sequenceFlow id="SequenceFlow_15" sourceRef="ServiceTask_3" targetRef="ParallelGateway_2"/>
    <sequenceFlow id="SequenceFlow_16" sourceRef="ParallelGateway_2" targetRef="ServiceTask_5"/>
    <sequenceFlow id="SequenceFlow_17" sourceRef="ServiceTask_5" targetRef="EndEvent_1"/>
    <sequenceFlow id="SequenceFlow_18" name="no" sourceRef="ExclusiveGateway_1" targetRef="UserTask_4"/>
    <sequenceFlow id="SequenceFlow_19" name="no" sourceRef="ExclusiveGateway_3" targetRef="UserTask_6"/>
    <sequenceFlow id="SequenceFlow_20" name="no" sourceRef="ExclusiveGateway_4" targetRef="UserTask_8"/>
    <sequenceFlow id="SequenceFlow_21" name="no" sourceRef="ExclusiveGateway_2" targetRef="UserTask_6"/>
    <sequenceFlow id="SequenceFlow_22" sourceRef="UserTask_6" targetRef="UserTask_8"/>
    <sequenceFlow id="SequenceFlow_23" name="yes" sourceRef="ExclusiveGateway_2" targetRef="ExclusiveGateway_3"/>
    <sequenceFlow id="SequenceFlow_24" name="yes" sourceRef="ExclusiveGateway_3" targetRef="ServiceTask_2"/>
    <sequenceFlow id="SequenceFlow_25" name="yes" sourceRef="ExclusiveGateway_4" targetRef="ServiceTask_5"/>
  </process>
</definitions>