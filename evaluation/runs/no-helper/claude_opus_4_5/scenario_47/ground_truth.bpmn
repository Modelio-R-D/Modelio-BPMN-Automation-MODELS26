    <serviceTask id="ServiceTask_2" name="system checks eligibility">
      <incoming>SequenceFlow_5</incoming>
      <outgoing>SequenceFlow_6</outgoing>
    </serviceTask>
    <serviceTask id="ServiceTask_3" name="system issues course tickets">
      <incoming>SequenceFlow_13</incoming>
      <outgoing>SequenceFlow_21</outgoing>
    </serviceTask>
    <exclusiveGateway id="ExclusiveGateway_1" name="free spots?">
