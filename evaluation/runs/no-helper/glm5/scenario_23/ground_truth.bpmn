<?xml version="1.0" ?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://www.omg.org/spec/BPMN/20100524/MODEL">
  <collaboration id="Collaboration_1">
    <participant id="Participant_1" name="credit scoring frontend (bank)" processRef="Process_1"/>
    <participant id="Participant_2" name="credit scoring (bank)" processRef="Process_2"/>
    <participant id="Participant_3" name="scoring service" processRef="Process_3"/>
    <messageFlow id="MessageFlow_1" sourceRef="Participant_1" targetRef="StartEvent_1"/>
    <messageFlow id="MessageFlow_2" sourceRef="Task_3" targetRef="Participant_1"/>
    <messageFlow id="MessageFlow_3" sourceRef="Task_2" targetRef="Participant_1"/>
    <messageFlow id="MessageFlow_4" sourceRef="Task_1" targetRef="StartEvent_2"/>
    <messageFlow id="MessageFlow_5" sourceRef="Task_5" targetRef="Task_1"/>
    <messageFlow id="MessageFlow_6" sourceRef="Task_7" targetRef="IntermediateCatchEvent_1"/>
  </collaboration>
  <process id="Process_1"/>
  <process id="Process_2">
    <task id="Task_1" name="request credit score">
      <incoming>SequenceFlow_1</incoming>
      <outgoing>SequenceFlow_2</outgoing>
    </task>
    <task id="Task_2" name="send credit score">
      <incoming>SequenceFlow_7</incoming>
      <outgoing>SequenceFlow_8</outgoing>
    </task>
    <task id="Task_3" name="report delay">
      <incoming>SequenceFlow_3</incoming>
      <outgoing>SequenceFlow_4</outgoing>
    </task>
    <exclusiveGateway id="ExclusiveGateway_1" name="score received?">
      <incoming>SequenceFlow_2</incoming>
      <outgoing>SequenceFlow_3</outgoing>
      <outgoing>SequenceFlow_6</outgoing>
    </exclusiveGateway>
    <exclusiveGateway id="ExclusiveGateway_2">
      <incoming>SequenceFlow_5</incoming>
      <incoming>SequenceFlow_6</incoming>
      <outgoing>SequenceFlow_7</outgoing>
    </exclusiveGateway>
    <startEvent id="StartEvent_1" name="scoring request received">
      <messageEventDefinition/>
      <outgoing>SequenceFlow_1</outgoing>
    </startEvent>
    <endEvent id="EndEvent_1" name="scoring request handled">
      <incoming>SequenceFlow_8</incoming>
    </endEvent>
    <intermediateCatchEvent id="IntermediateCatchEvent_1" name="credit score received">
      <messageEventDefinition/>
      <incoming>SequenceFlow_4</incoming>
      <outgoing>SequenceFlow_5</outgoing>
    </intermediateCatchEvent>
    <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_1"/>
    <sequenceFlow id="SequenceFlow_2" sourceRef="Task_1" targetRef="ExclusiveGateway_1"/>
    <sequenceFlow id="SequenceFlow_3" name="no" sourceRef="ExclusiveGateway_1" targetRef="Task_3"/>
    <sequenceFlow id="SequenceFlow_4" sourceRef="Task_3" targetRef="IntermediateCatchEvent_1"/>
    <sequenceFlow id="SequenceFlow_5" sourceRef="IntermediateCatchEvent_1" targetRef="ExclusiveGateway_2"/>
    <sequenceFlow id="SequenceFlow_6" name="yes" sourceRef="ExclusiveGateway_1" targetRef="ExclusiveGateway_2"/>
    <sequenceFlow id="SequenceFlow_7" sourceRef="ExclusiveGateway_2" targetRef="Task_2"/>
    <sequenceFlow id="SequenceFlow_8" sourceRef="Task_2" targetRef="EndEvent_1"/>
  </process>
  <process id="Process_3">
    <task id="Task_4" name="compute credit score (level 1)">
      <incoming>SequenceFlow_9</incoming>
      <outgoing>SequenceFlow_10</outgoing>
    </task>
    <task id="Task_5" name="send result">
      <incoming>SequenceFlow_10</incoming>
      <outgoing>SequenceFlow_11</outgoing>
    </task>
    <task id="Task_6" name="compute credit score (level 2)">
      <incoming>SequenceFlow_12</incoming>
      <outgoing>SequenceFlow_13</outgoing>
    </task>
    <task id="Task_7" name="send credit score">
      <incoming>SequenceFlow_13</incoming>
      <outgoing>SequenceFlow_14</outgoing>
    </task>
    <exclusiveGateway id="ExclusiveGateway_3" name="score available?">
      <incoming>SequenceFlow_11</incoming>
      <outgoing>SequenceFlow_12</outgoing>
      <outgoing>SequenceFlow_16</outgoing>
    </exclusiveGateway>
    <exclusiveGateway id="ExclusiveGateway_4">
      <incoming>SequenceFlow_14</incoming>
      <incoming>SequenceFlow_16</incoming>
      <outgoing>SequenceFlow_15</outgoing>
    </exclusiveGateway>
    <startEvent id="StartEvent_2" name="scoring request received">
      <messageEventDefinition/>
      <outgoing>SequenceFlow_9</outgoing>
    </startEvent>
    <endEvent id="EndEvent_2" name="scoring request handled">
      <incoming>SequenceFlow_15</incoming>
    </endEvent>
    <sequenceFlow id="SequenceFlow_9" sourceRef="StartEvent_2" targetRef="Task_4"/>
    <sequenceFlow id="SequenceFlow_10" sourceRef="Task_4" targetRef="Task_5"/>
    <sequenceFlow id="SequenceFlow_11" sourceRef="Task_5" targetRef="ExclusiveGateway_3"/>
    <sequenceFlow id="SequenceFlow_12" name="no" sourceRef="ExclusiveGateway_3" targetRef="Task_6"/>
    <sequenceFlow id="SequenceFlow_13" sourceRef="Task_6" targetRef="Task_7"/>
    <sequenceFlow id="SequenceFlow_14" sourceRef="Task_7" targetRef="ExclusiveGateway_4"/>
    <sequenceFlow id="SequenceFlow_15" sourceRef="ExclusiveGateway_4" targetRef="EndEvent_2"/>
    <sequenceFlow id="SequenceFlow_16" name="yes" sourceRef="ExclusiveGateway_3" targetRef="ExclusiveGateway_4"/>
  </process>
</definitions>