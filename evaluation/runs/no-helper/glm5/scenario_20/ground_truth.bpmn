    <startEvent id="StartEvent_1" name="start">
      <outgoing>SequenceFlow_18</outgoing>
    </startEvent>
    <endEvent id="EndEvent_1" name="end">
      <incoming>SequenceFlow_10</incoming>
    </endEvent>
    <sequenceFlow id="SequenceFlow_1" sourceRef="ParallelGateway_3" targetRef="Task_9"/>
    <sequenceFlow id="SequenceFlow_2" sourceRef="ExclusiveGateway_2" targetRef="ExclusiveGateway_1"/>
    <sequenceFlow id="SequenceFlow_3" sourceRef="Task_4" targetRef="ParallelGateway_3"/>
